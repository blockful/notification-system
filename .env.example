# Notification System Environment Variables
# Copy this file to .env and configure your settings

# === REQUIRED CONFIGURATION ===
ANTICAPTURE_API_URL=https://api-gateway-production-0879.up.railway.app
BLOCKFUL_API_TOKEN=

# === NOTIFICATION PLATFORMS ===
TELEGRAM_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-domain.com/slack/oauth/callback
SLACK_SIGNING_SECRET=
TOKEN_ENCRYPTION_KEY=  # Generate: openssl rand -hex 32

# === LOCAL DEV CONFIGURATION ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
RABBITMQ_URL=amqp://admin:admin@localhost:5672
TRIGGER_INTERVAL=30000  # ms (logic-system)
PROPOSAL_STATUS=ACTIVE  # (logic-system)

# ProposalExecutable trigger (webhook-only). Delay must match the DAOs' governor timelock.
PROPOSAL_EXECUTABLE_DAOS=ENS
PROPOSAL_EXECUTABLE_TIMELOCK_DELAY_SECONDS=172800
PROPOSAL_EXECUTABLE_MARGIN_SECONDS=3600
PROPOSAL_EXECUTABLE_LOOKBACK_DAYS=3

# Per-service PORT — use per-app .env files for cleaner separation
# subscription-server PORT=3002
# logic-system PORT=3003
